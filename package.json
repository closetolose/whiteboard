{
  "name": "whiteboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "cross-env PORT=3001 tsx watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0 --port 3000",
    "tunnel": "node scripts/run-tunnel.mjs",
    "dev:public": "concurrently -k -n server,client,tunnel -c blue,green,magenta \"npm:dev:server\" \"npm:dev:client\" \"npm:tunnel\"",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "hash-password": "node scripts/hash-admin-password.mjs",
    "ai:diagnose": "node --dns-result-order=ipv4first --no-network-family-autoselection --import tsx scripts/diagnose-ai.mjs",
    "reset-rooms": "node scripts/reset-rooms.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:browser": "node tests/serve-browser.mjs",
    "test:browser:ai": "node --import tsx tests/serve-ai-browser.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.6",
    "@tldraw/sync": "^5.3.2",
    "@tldraw/sync-core": "^5.3.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.4",
    "tldraw": "^5.3.2",
    "uuid": "^11.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "oxlint": "^1.79.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
