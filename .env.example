NODE_ENV=development
PORT=3001

# Local dev only — copy to .env and set your own values (never commit .env)
ADMIN_PASSWORD=
SESSION_SECRET=
ASSET_TOTAL_MB=512
ASSET_BOARD_MB=100

# Server only: enables gpt-6-luna for every participant with a board link.
OPENAI_API_KEY=
# Shared hourly request limit across all boards (up to 3 API calls per request).
AI_REQUESTS_PER_HOUR=120

# Production: tldraw license (required for HTTPS). Free 100-day trial:
# https://tldraw.dev/get-a-license/trial — add domain whiteboard.all4tutors.ru
# VITE_TLDRAW_LICENSE_KEY=

# Production: use bcrypt hash instead of plain password
# ADMIN_PASSWORD_HASH=
