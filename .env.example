NODE_ENV=development
PORT=3001

# Local dev only — copy to .env and set your own values (never commit .env)
ADMIN_PASSWORD=
SESSION_SECRET=
ASSET_TOTAL_MB=512
ASSET_BOARD_MB=100

# Production: tldraw license (required for HTTPS). Free 100-day trial:
# https://tldraw.dev/get-a-license/trial — add domain whiteboard.all4tutors.ru
# VITE_TLDRAW_LICENSE_KEY=

# Production: use bcrypt hash instead of plain password
# ADMIN_PASSWORD_HASH=
