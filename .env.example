NODE_ENV=development
PORT=3001

# Local dev only — copy to .env and set your own values (never commit .env)
ADMIN_PASSWORD=
SESSION_SECRET=
ASSET_TOTAL_MB=512
ASSET_BOARD_MB=100

# Server defaults; the admin AI settings form takes priority after saving.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Shared hourly request limit across all boards (one API call per request).
AI_REQUESTS_PER_HOUR=120

# Production: tldraw license (required for HTTPS). Free 100-day trial:
# https://tldraw.dev/get-a-license/trial — add domain whiteboard.all4tutors.ru
# VITE_TLDRAW_LICENSE_KEY=

# Production: use bcrypt hash instead of plain password
# ADMIN_PASSWORD_HASH=
