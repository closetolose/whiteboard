# Full nginx config after certbot (HTTPS + WebSocket for /connect/).
# Install:
#   sudo cp deploy/nginx.ssl.conf.example /etc/nginx/sites-available/whiteboard
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name whiteboard.all4tutors.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name whiteboard.all4tutors.ru;

    ssl_certificate /etc/letsencrypt/live/whiteboard.all4tutors.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/whiteboard.all4tutors.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 50m;

    # WebSocket sync — MUST be a separate location with Upgrade headers
    location /connect/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
