NODE_ENV=production
PORT=3000

# Generate with: npm run hash-password
ADMIN_PASSWORD_HASH=

# Random string, 32+ characters (openssl rand -hex 32)
SESSION_SECRET=
ASSET_TOTAL_MB=512
ASSET_BOARD_MB=100

# Server only — never use a VITE_ prefix for this key.
# Defaults before saving AI settings in /admin; available to board participants.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_REQUESTS_PER_HOUR=120

# Required for production HTTPS — get a free 100-day trial at:
# https://tldraw.dev/get-a-license/trial (domain: whiteboard.all4tutors.ru)
# Must be set before `npm run build` (Vite bakes it into the client bundle).
VITE_TLDRAW_LICENSE_KEY=
