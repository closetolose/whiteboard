[Unit]
Description=Whiteboard collaborative board
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/whiteboard
Environment=NODE_ENV=production
Environment=PORT=3000
Environment="NODE_OPTIONS=--max-old-space-size=384 --dns-result-order=ipv4first --no-network-family-autoselection"
EnvironmentFile=/home/deploy/whiteboard/.env
ExecStart=/usr/bin/node --import tsx server/index.ts
KillSignal=SIGTERM
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
