# Copy to /etc/nginx/sites-available/whiteboard and symlink to sites-enabled.
# Replace board.example.ru with your subdomain.
#
# 1. Use this HTTP-only config first:
#    sudo nginx -t && sudo systemctl reload nginx
# 2. Then issue TLS:
#    sudo certbot --nginx -d board.example.ru
# Certbot will add the HTTPS server block and redirect automatically.

server {
    listen 80;
    server_name board.example.ru;

    client_max_body_size 10m;

    location /connect/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
