# Copy to /etc/nginx/sites-available/whiteboard and symlink to sites-enabled.
# Replace board.example.ru with your domain.

server {
    listen 80;
    server_name board.example.ru;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name board.example.ru;

    # certbot fills these paths:
    ssl_certificate /etc/letsencrypt/live/board.example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/board.example.ru/privkey.pem;

    client_max_body_size 50m;

    location /connect/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
